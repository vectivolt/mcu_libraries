{
  "name": "joulesuite-ui",
  "version": "1.0.0",
  "description": "Svelte 5 source for the four JouleSuite web UIs. Built into self-contained HTML blobs and embedded as gzipped PROGMEM into the C++ libraries.",
  "author": "Chinmoy Bhuyan <dikibhuyan@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:dash": "vite --config apps/dash/vite.config.js",
    "dev:ota": "vite --config apps/ota/vite.config.js",
    "dev:serial": "vite --config apps/serial/vite.config.js",
    "dev:net": "vite --config apps/net/vite.config.js",
    "build": "node scripts/build-all.js",
    "embed": "node scripts/embed-progmem.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "bits-ui": "^1.3.0",
    "lucide-svelte": "^0.460.0",
    "playwright": "^1.60.0",
    "svelte": "^5.20.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.2.0"
  },
  "dependencies": {
    "terser": "^5.48.0"
  }
}
